<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="client.BidderHomeController"
            styleClass="app-shell">

    <!-- TOP APP BAR -->
    <top>
        <VBox styleClass="app-bar" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="AUCTION HOUSE" styleClass="app-brand, app-brand-accent"/>
                </HBox>
                <Label text="BIDDER" styleClass="app-role-pill"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" styleClass="app-username"/>
                <Button text="REFRESH" onAction="#handleRefresh" styleClass="dashboard-btn-ghost"/>
                <Button text="CHANGE PASSWORD" onAction="#handleChangePassword" styleClass="dashboard-btn-ghost"/>
                <Button text="LOGOUT" onAction="#handleLogout" styleClass="dashboard-btn-logout"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox styleClass="app-content" spacing="22">

                <!-- Wallet card -->
                <HBox styleClass="dash-card-accent" spacing="20" alignment="CENTER_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="WALLET BALANCE" styleClass="balance-label"/>
                        <Label fx:id="walletBalanceLabel" text="Balance: loading..."
                               styleClass="balance-amount"/>
                        <Label text="Deposit requests are approved by an admin before funds are added."
                               styleClass="dashboard-section-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="REQUEST DEPOSIT" onAction="#handleDepositRequest"
                                styleClass="dashboard-btn-primary" prefWidth="190"/>
                        <Button text="REQUEST WITHDRAW" onAction="#handleWithdrawRequest"
                                styleClass="dashboard-btn-ghost" prefWidth="190"/>
                    </VBox>
                </HBox>

                <!-- Live Auctions section -->
                <VBox styleClass="dash-card" spacing="18">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Live Auctions" styleClass="dashboard-section-title"/>
                            <Label text="Double-click an auction card to bid, auto-bid or view its price chart."
                                   styleClass="dashboard-section-subtitle"/>
                        </VBox>
                    </HBox>

                    <!-- Search and Sort Controls -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField"
                                   promptText="Search by item name..."
                                   HBox.hgrow="ALWAYS"
                                   styleClass="dashboard-input"/>
                        <ComboBox fx:id="sortComboBox" promptText="Sort by..."
                                  prefWidth="220" styleClass="dashboard-choicebox"/>
                    </HBox>

                    <TilePane fx:id="auctionGrid" hgap="18" vgap="18"
                              prefColumns="4"
                              style="-fx-padding: 4 0 4 0;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
