<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="client.RegisterController"
           styleClass="auth-root">

    <HBox alignment="CENTER" spacing="0">

        <!-- LEFT: Brand / Hero panel -->
        <VBox styleClass="auth-hero" alignment="CENTER_LEFT" spacing="28"
              prefWidth="420" minWidth="300" HBox.hgrow="SOMETIMES">
            <VBox spacing="16" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="AUCTION HOUSE" styleClass="brand-mark, brand-accent"/>
                </HBox>
                <Label text="Premium live auctions" styleClass="brand-tagline"/>
            </VBox>

            <VBox spacing="18" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <Label text="JOIN THE COMMUNITY" styleClass="hero-pill"/>
                <Label text="Create your account in under a minute."
                       styleClass="hero-headline" wrapText="true"/>
                <Label text="Become a bidder, seller and start exploring exclusive lots."
                       styleClass="hero-subline" wrapText="true"/>
            </VBox>

            <VBox spacing="14" alignment="BOTTOM_LEFT">
                <Separator styleClass="hero-divider"/>
                <Label text="© 2026 Auction House — Established 2026" styleClass="footer-text"/>
            </VBox>
        </VBox>

        <!-- RIGHT: Form panel -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #0d0d17;">
            <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent;">
                <VBox alignment="CENTER" style="-fx-padding: 50 40 50 40;">
                    <VBox styleClass="auth-card" spacing="26"
                          style="-fx-padding: 40;">

                        <!-- Header -->
                        <VBox spacing="6">
                            <Label text="Create account" styleClass="register-title-main"/>
                            <Label text="Set up your profile and security details"
                                   styleClass="register-subtitle-main"/>
                        </VBox>

                        <!-- Account Information -->
                        <VBox spacing="14">
                            <Label text="ACCOUNT INFORMATION" styleClass="form-section-title"/>

                            <VBox spacing="6">
                                <Label text="USERNAME" styleClass="form-label-register"/>
                                <TextField fx:id="usernameField"
                                           promptText="6–20 characters"
                                           styleClass="register-input"/>
                                <Label fx:id="usernameError" styleClass="error-label"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="EMAIL" styleClass="form-label-register"/>
                                <TextField fx:id="emailField"
                                           promptText="you@example.com"
                                           styleClass="register-input"/>
                                <Label fx:id="emailError" styleClass="error-label"/>
                            </VBox>

                            <HBox spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="PASSWORD" styleClass="form-label-register"/>
                                    <PasswordField fx:id="passwordField"
                                                   promptText="Upper, lower, number, symbol"
                                                   styleClass="register-input"/>
                                    <Label fx:id="passwordError" styleClass="error-label"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="CONFIRM PASSWORD" styleClass="form-label-register"/>
                                    <PasswordField fx:id="confirmPasswordField"
                                                   promptText="Re-enter password"
                                                   styleClass="register-input"/>
                                    <Label fx:id="confirmPasswordError" styleClass="error-label"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Security Questions -->
                        <VBox spacing="14">
                            <Label text="SECURITY QUESTIONS" styleClass="form-section-title"/>

                            <HBox spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="QUESTION 1" styleClass="form-label-register"/>
                                    <TextField fx:id="q1Field"
                                               promptText="e.g. Pet's name?"
                                               styleClass="register-input"/>
                                    <Label fx:id="q1Error" styleClass="error-label"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="ANSWER 1" styleClass="form-label-register"/>
                                    <TextField fx:id="a1Field"
                                               promptText="Your answer"
                                               styleClass="register-input"/>
                                    <Label fx:id="a1Error" styleClass="error-label"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="QUESTION 2" styleClass="form-label-register"/>
                                    <TextField fx:id="q2Field"
                                               promptText="e.g. Birth city?"
                                               styleClass="register-input"/>
                                    <Label fx:id="q2Error" styleClass="error-label"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="ANSWER 2" styleClass="form-label-register"/>
                                    <TextField fx:id="a2Field"
                                               promptText="Your answer"
                                               styleClass="register-input"/>
                                    <Label fx:id="a2Error" styleClass="error-label"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Role -->
                        <VBox spacing="14">
                            <Label text="ACCOUNT TYPE" styleClass="form-section-title"/>
                            <VBox spacing="6">
                                <Label text="ROLE" styleClass="form-label-register"/>
                                <ChoiceBox fx:id="roleBox" maxWidth="Infinity"
                                           styleClass="register-choice"/>
                            </VBox>
                        </VBox>

                        <Label fx:id="formError" styleClass="form-error" wrapText="true"/>

                        <!-- Buttons -->
                        <VBox spacing="12">
                            <Button text="CREATE ACCOUNT" onAction="#handleRegister"
                                    styleClass="register-btn-primary"
                                    maxWidth="Infinity"/>
                            <Button text="Back to sign in" onAction="#goBack"
                                    styleClass="register-btn-secondary"
                                    maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>

    </HBox>
</StackPane>
