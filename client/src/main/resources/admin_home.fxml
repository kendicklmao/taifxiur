<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="client.controller.AdminHomeController"
            styleClass="app-shell">

    <top>
        <VBox styleClass="app-bar" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="VinAuction" styleClass="app-brand, app-brand-accent"/>
                </HBox>
                <Label text="ADMIN" styleClass="app-role-pill"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" styleClass="app-username"/>
                <Button text="CHANGE PASSWORD" onAction="#handleChangePassword" styleClass="dashboard-btn-ghost"/>
                <Button text="LOG OUT" onAction="#handleLogout" styleClass="dashboard-btn-logout"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <Tab text="All Auctions" closable="false">
                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
                    <VBox styleClass="app-content" spacing="22">
                        <HBox spacing="22" VBox.vgrow="ALWAYS">
                            <!-- AUCTION LIST -->
                            <VBox styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="1000" VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label text="All Auctions in System" styleClass="dashboard-section-title"/>
                                    <Label text="Browse all active and completed auctions"
                                           styleClass="dashboard-section-subtitle"/>
                                </VBox>
                                <ListView fx:id="allAuctionsList" VBox.vgrow="ALWAYS"/>
                                <HBox spacing="10">
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Button text="REFRESH" onAction="#refreshAuctions"
                                            styleClass="dashboard-btn-primary" prefWidth="140"/>
                                </HBox>
                            </VBox>

                            <!-- AUCTION DETAIL -->
                            <VBox fx:id="auctionDetailPane" styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="1000" VBox.vgrow="ALWAYS" managed="false" visible="false">
                                <!-- Auction details will be populated here -->
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="User Management" closable="false">
                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
                    <VBox styleClass="app-content" spacing="22">
                        <HBox spacing="22" VBox.vgrow="ALWAYS">
                            <!-- USER LIST -->
                            <VBox styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="1000" VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label text="User Management" styleClass="dashboard-section-title"/>
                                    <Label text="View all registered users and control their access" styleClass="dashboard-section-subtitle"/>
                                </VBox>
                                <ListView fx:id="allUsersList" VBox.vgrow="ALWAYS"/>
                                <HBox spacing="10">
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Button text="REFRESH" onAction="#refreshUsers"
                                            styleClass="dashboard-btn-primary" prefWidth="140"/>
                                </HBox>
                            </VBox>

                            <VBox styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="1000" VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label text="Actions" styleClass="dashboard-section-title"/>
                                    <Label text="Ban or unban a user" styleClass="dashboard-section-subtitle"/>
                                </VBox>
                                <VBox spacing="12">
                                    <ComboBox fx:id="usernameField" editable="true"
                                              promptText="Search or select username"
                                              styleClass="dashboard-choicebox"
                                              maxWidth="Infinity"/>
                                    <HBox spacing="12">
                                        <Button text="BAN USER" onAction="#handleBanUser"
                                                styleClass="dashboard-btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                        <Button text="UNBAN USER" onAction="#handleUnbanUser"
                                                styleClass="dashboard-btn-success" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                                <TextArea fx:id="userStatusArea" editable="false" wrapText="true"
                                          prefRowCount="10" styleClass="dashboard-input" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="Wallet Requests" closable="false">
                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
                    <VBox styleClass="app-content" spacing="22">
                        <HBox spacing="22" VBox.vgrow="ALWAYS">
                            <!-- DEPOSIT REQUESTS -->
                            <VBox styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="1000" VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label text="Pending Deposit Requests" styleClass="dashboard-section-title"/>
                                    <Label text="Approve bidder deposits to increase their wallet balance"
                                           styleClass="dashboard-section-subtitle"/>
                                </VBox>
                                <ListView fx:id="depositRequestsList" VBox.vgrow="ALWAYS"/>
                                <HBox spacing="12">
                                    <Button text="APPROVE" onAction="#handleApproveDepositRequest"
                                            styleClass="dashboard-btn-success" prefWidth="110"/>
                                    <Button text="REJECT" onAction="#handleRejectDepositRequest"
                                            styleClass="dashboard-btn-danger" prefWidth="110"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Button text="REFRESH" onAction="#refreshDepositRequests"
                                            styleClass="dashboard-btn-primary" prefWidth="120"/>
                                </HBox>
                            </VBox>

                            <VBox styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="1000" VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label text="Pending Withdraw Requests" styleClass="dashboard-section-title"/>
                                    <Label text="Approve seller withdrawals to deduct money from wallet balance"
                                           styleClass="dashboard-section-subtitle"/>
                                </VBox>
                                <ListView fx:id="withdrawRequestsList" VBox.vgrow="ALWAYS"/>
                                <HBox spacing="12">
                                    <Button text="APPROVE" onAction="#handleApproveWithdrawRequest"
                                            styleClass="dashboard-btn-success" prefWidth="110"/>
                                    <Button text="REJECT" onAction="#handleRejectWithdrawRequest"
                                            styleClass="dashboard-btn-danger" prefWidth="110"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Button text="REFRESH" onAction="#refreshWithdrawRequests"
                                            styleClass="dashboard-btn-primary" prefWidth="120"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
