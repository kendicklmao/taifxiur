<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="client.SellerHomeController"
            styleClass="app-shell">

    <!-- TOP APP BAR -->
    <top>
        <VBox styleClass="app-bar" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="AUCTION" styleClass="app-brand, app-brand-accent"/>
                </HBox>
                <Label text="SELLER" styleClass="app-role-pill"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" styleClass="app-username"/>
                <Button text="REFRESH" onAction="#handleRefresh" styleClass="dashboard-btn-ghost"/>
                <Button text="CHANGE PASSWORD" onAction="#handleChangePassword" styleClass="dashboard-btn-ghost"/>
                <Button text="LOGOUT" onAction="#handleLogout" styleClass="dashboard-btn-logout"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox styleClass="app-content" spacing="22">

                <!-- Wallet card -->
                <HBox styleClass="dash-card-accent" spacing="20" alignment="CENTER_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="WALLET BALANCE" styleClass="balance-label"/>
                        <Label fx:id="walletBalanceLabel" text="Balance: loading..."
                               styleClass="balance-amount"/>
                        <Label text="Withdraw requests are reviewed by an admin and approved requests deduct from your balance."
                               styleClass="dashboard-section-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="REQUEST WITHDRAW" onAction="#handleWithdrawRequest"
                                styleClass="dashboard-btn-primary" prefWidth="200"/>
                    </VBox>
                </HBox>

                <!-- Two-column responsive area: Create Auction + Your Auctions -->
                <HBox spacing="22">

                    <!-- CREATE AUCTION -->
                    <VBox styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS"
                          minWidth="380" prefWidth="520">
                        <VBox spacing="4">
                            <Label text="Create New Auction" styleClass="dashboard-section-title"/>
                            <Label text="List a new item for live auction"
                                   styleClass="dashboard-section-subtitle"/>
                        </VBox>

                        <!-- Product Name -->
                        <VBox spacing="6">
                            <Label text="PRODUCT NAME" styleClass="form-label-register"/>
                            <TextField fx:id="itemNameField" promptText="Enter product name"
                                       styleClass="dashboard-input"/>
                        </VBox>

                        <HBox spacing="14">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="STARTING PRICE" styleClass="form-label-register"/>
                                <TextField fx:id="startPriceField" promptText="e.g. 1000"
                                           styleClass="dashboard-input"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="CATEGORY" styleClass="form-label-register"/>
                                <ChoiceBox fx:id="categoryBox" maxWidth="Infinity"
                                           styleClass="dashboard-choicebox"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="14">
                            <VBox spacing="6">
                                <Label text="MINIMUM INCREMENT TYPE" styleClass="form-label-register"/>
                                <ChoiceBox fx:id="incrementTypeBox" maxWidth="Infinity"
                                           styleClass="dashboard-choicebox"/>
                            </VBox>
                            <VBox fx:id="customIncrementPane" spacing="6"
                                  visible="false" managed="false">
                                <Label text="CUSTOM INCREMENT AMOUNT ($)"
                                       styleClass="form-label-register"/>
                                <TextField fx:id="customIncrementField"
                                           promptText="e.g. 100"
                                           styleClass="dashboard-input"/>
                            </VBox>
                        </VBox>

                        <!-- Auction Timing -->
                        <Label text="AUCTION TIMING" styleClass="form-section-title"/>
                        <VBox fx:id="customTimingPane" spacing="14" visible="true" managed="true">
                            <HBox spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="START DATE" styleClass="form-label-register"/>
                                    <DatePicker fx:id="startDatePicker" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="START TIME" styleClass="form-label-register"/>
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <Spinner fx:id="startHourSpinner" prefWidth="90" editable="true"/>
                                        <Label text=":" style="-fx-text-fill: #8b8ba7;"/>
                                        <Spinner fx:id="startMinuteSpinner" prefWidth="90" editable="true"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                            <HBox spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="END DATE" styleClass="form-label-register"/>
                                    <DatePicker fx:id="endDatePicker" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="END TIME" styleClass="form-label-register"/>
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <Spinner fx:id="endHourSpinner" prefWidth="90" editable="true"/>
                                        <Label text=":" style="-fx-text-fill: #8b8ba7;"/>
                                        <Spinner fx:id="endMinuteSpinner" prefWidth="90" editable="true"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="6">
                            <Label text="DESCRIPTION" styleClass="form-label-register"/>
                            <TextArea fx:id="descField" promptText="Tell bidders about this item..."
                                      prefRowCount="4" wrapText="true"
                                      styleClass="dashboard-input"/>
                        </VBox>

                        <!-- Image Upload -->
                        <VBox spacing="6">
                            <Label text="IMAGE" styleClass="form-label-register"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Button onAction="#handleUploadImage" text="UPLOAD IMAGE"
                                        styleClass="dashboard-btn-ghost"/>
                                <ImageView fx:id="itemImageView" fitHeight="80" fitWidth="80"
                                           preserveRatio="true"/>
                            </HBox>
                        </VBox>

                        <!-- Dynamic attributes -->
                        <VBox fx:id="dynamicForm" spacing="12"/>

                        <Button text="CREATE AUCTION" onAction="#handleCreateAuction"
                                styleClass="dashboard-btn-primary"
                                maxWidth="Infinity" prefHeight="48"/>
                    </VBox>

                    <!-- YOUR AUCTIONS -->
                    <VBox styleClass="dash-card" spacing="16" HBox.hgrow="ALWAYS"
                          minWidth="320">
                        <VBox spacing="4">
                            <Label text="Your Active Auctions" styleClass="dashboard-section-title"/>
                            <Label text="Manage your ongoing listings"
                                   styleClass="dashboard-section-subtitle"/>
                        </VBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                    style="-fx-background-color: transparent;">
                            <TilePane fx:id="auctionGrid" hgap="16" vgap="16"
                                      style="-fx-padding: 4;"/>
                        </ScrollPane>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
