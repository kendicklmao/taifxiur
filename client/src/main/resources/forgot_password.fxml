<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="client.ForgotPasswordController"
           styleClass="auth-root">

    <HBox alignment="CENTER" spacing="0">

        <!-- LEFT: Brand / Hero panel -->
        <VBox styleClass="auth-hero" alignment="CENTER_LEFT" spacing="28"
              prefWidth="420" minWidth="300" HBox.hgrow="SOMETIMES">
            <VBox spacing="16" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="AUCTION HOUSE" styleClass="brand-mark, brand-accent"/>
                </HBox>
                <Label text="Premium live auctions" styleClass="brand-tagline"/>
            </VBox>

            <VBox spacing="18" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <Label text="ACCOUNT RECOVERY" styleClass="hero-pill"/>
                <Label text="Forgot your password? We'll get you back in."
                       styleClass="hero-headline" wrapText="true"/>
                <Label text="Verify your identity with the security questions you set up at registration."
                       styleClass="hero-subline" wrapText="true"/>
            </VBox>

            <VBox spacing="14" alignment="BOTTOM_LEFT">
                <Separator styleClass="hero-divider"/>
                <Label text="Protected by Auction House security" styleClass="footer-text"/>
            </VBox>
        </VBox>

        <!-- RIGHT: Form panel -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #0d0d17;">
            <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent;">
                <VBox alignment="CENTER" style="-fx-padding: 50 40 50 40;">
                    <VBox styleClass="auth-card" maxWidth="500" spacing="26"
                          style="-fx-padding: 40;">

                        <!-- Header -->
                        <VBox spacing="6">
                            <Label text="Reset password" styleClass="register-title-main"/>
                            <Label text="Verify your account and set a new password"
                                   styleClass="register-subtitle-main"/>
                        </VBox>

                        <!-- Identification -->
                        <VBox spacing="14">
                            <Label text="STEP 1 — IDENTIFY YOUR ACCOUNT" styleClass="form-section-title"/>

                            <VBox spacing="6">
                                <Label text="USERNAME" styleClass="form-label-register"/>
                                <TextField fx:id="usernameField"
                                           promptText="Enter your username"
                                           styleClass="register-input"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="EMAIL" styleClass="form-label-register"/>
                                <TextField fx:id="emailField"
                                           promptText="Enter your registered email"
                                           styleClass="register-input"/>
                            </VBox>
                            <Button fx:id="loadQuestionsButton"
                                    text="LOAD SECURITY QUESTIONS"
                                    onAction="#handleLoadQuestions"
                                    maxWidth="Infinity"
                                    styleClass="register-btn-primary"/>
                        </VBox>

                        <!-- Verification -->
                        <VBox fx:id="verificationBox" spacing="14">
                            <Label text="STEP 2 — SECURITY VERIFICATION" styleClass="form-section-title"/>

                            <VBox spacing="6" styleClass="forgot-question-box">
                                <Label text="QUESTION 1" styleClass="form-label-register"/>
                                <Label fx:id="question1Label" wrapText="true"
                                       styleClass="forgot-question-text"/>
                            </VBox>
                            <TextField fx:id="answer1Field"
                                       promptText="Answer for question 1"
                                       styleClass="register-input"/>

                            <VBox spacing="6" styleClass="forgot-question-box">
                                <Label text="QUESTION 2" styleClass="form-label-register"/>
                                <Label fx:id="question2Label" wrapText="true"
                                       styleClass="forgot-question-text"/>
                            </VBox>
                            <TextField fx:id="answer2Field"
                                       promptText="Answer for question 2"
                                       styleClass="register-input"/>

                            <HBox spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="NEW PASSWORD" styleClass="form-label-register"/>
                                    <PasswordField fx:id="newPasswordField"
                                                   promptText="Min 6 chars, mixed types"
                                                   styleClass="register-input"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="CONFIRM" styleClass="form-label-register"/>
                                    <PasswordField fx:id="confirmPasswordField"
                                                   promptText="Re-enter new password"
                                                   styleClass="register-input"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Buttons -->
                        <VBox spacing="12">
                            <Button fx:id="resetPasswordButton"
                                    text="RESET PASSWORD"
                                    onAction="#handleResetPassword"
                                    maxWidth="Infinity"
                                    styleClass="register-btn-primary"/>
                            <HBox spacing="12">
                                <Button fx:id="switchAccountButton"
                                        text="USE ANOTHER ACCOUNT"
                                        onAction="#handleUseAnotherAccount"
                                        styleClass="register-btn-secondary"
                                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Button text="BACK TO SIGN IN"
                                        onAction="#goBack"
                                        styleClass="register-btn-secondary"
                                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>

    </HBox>
</StackPane>
