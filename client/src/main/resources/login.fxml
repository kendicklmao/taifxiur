<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="client.controller.LoginController"
           styleClass="auth-root">

    <HBox alignment="CENTER" spacing="0">

        <!-- LEFT: Brand / Hero panel -->
        <VBox styleClass="auth-hero" alignment="CENTER_LEFT" spacing="28"
              prefWidth="460" minWidth="320" HBox.hgrow="SOMETIMES">
            <VBox spacing="16" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="AUCTION HOUSE" styleClass="brand-mark, brand-accent"/>
                </HBox>
                <Label text="Premium live auctions" styleClass="brand-tagline"/>
            </VBox>

            <VBox spacing="18" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <Label text="LIVE NOW" styleClass="hero-pill"/>
                <Label text="Bid on rare collectibles, art and electronics."
                       styleClass="hero-headline" wrapText="true"/>
                <Label text="Join thousands of collectors discovering exclusive auctions every day."
                       styleClass="hero-subline" wrapText="true"/>
            </VBox>

            <VBox spacing="14" alignment="BOTTOM_LEFT">
                <Separator styleClass="hero-divider"/>
                <Label text="© 2026 Auction House — Established 2026" styleClass="footer-text"/>
            </VBox>
        </VBox>

        <!-- RIGHT: Form panel -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #0d0d17;">
            <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent;">
                <VBox alignment="CENTER" style="-fx-padding: 60 40 60 40;">
                    <VBox styleClass="auth-card" maxWidth="440" spacing="28"
                          style="-fx-padding: 44;">

                        <!-- Header -->
                        <VBox spacing="6">
                            <Label text="Welcome back!" styleClass="login-title-main"/>
                            <Label text="Sign in to continue bidding"
                                   styleClass="login-subtitle-main"/>
                        </VBox>

                        <!-- Form -->
                        <VBox spacing="18">
                            <VBox spacing="8">
                                <Label text="USERNAME" styleClass="form-label-login"/>
                                <TextField fx:id="usernameField"
                                           promptText="Enter your username"
                                           styleClass="login-input"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="PASSWORD" styleClass="form-label-login"/>
                                <PasswordField fx:id="passwordField"
                                               promptText="Enter your password"
                                               styleClass="login-input"/>
                            </VBox>

                            <HBox alignment="CENTER_RIGHT">
                                <Hyperlink text="Forgot password?"
                                           onAction="#goToForgotPassword"
                                           styleClass="login-link"/>
                            </HBox>
                        </VBox>

                        <!-- Buttons -->
                        <VBox spacing="12">
                            <Button fx:id="loginButton" text="SIGN IN" onAction="#handleLogin"
                                    styleClass="login-btn-primary"
                                    maxWidth="Infinity" defaultButton="true"/>
                            <Label fx:id="countdownLabel" styleClass="countdown-label" alignment="CENTER" maxWidth="Infinity"/>
                            <Button text="Create new account"
                                    onAction="#goToRegister"
                                    styleClass="login-btn-secondary"
                                    maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>

    </HBox>
</StackPane>
