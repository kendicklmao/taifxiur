<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.AuctionChartController"
      alignment="TOP_CENTER" spacing="16"
      styleClass="app-shell"
      style="-fx-padding: 24; -fx-background-color: #0d0d17;">

    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <VBox spacing="6" alignment="CENTER_LEFT">
        <Label text="PRICE HISTORY" styleClass="balance-label"/>
        <Label fx:id="chartTitleLabel" styleClass="dashboard-section-title"/>
    </VBox>

    <VBox styleClass="dash-card" spacing="0" VBox.vgrow="ALWAYS">
        <LineChart fx:id="priceChart" prefHeight="420" prefWidth="640" createSymbols="true"
                   legendVisible="false" animated="false">
            <xAxis>
                <CategoryAxis label="Time of Bid"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Price (VND)"/>
            </yAxis>
        </LineChart>
    </VBox>
</VBox>
