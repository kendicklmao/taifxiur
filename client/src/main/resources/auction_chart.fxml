<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.AuctionChartController"
      alignment="CENTER" spacing="10"
      style="-fx-padding: 20; -fx-background-color: #f8f7f5;">

    <Label fx:id="chartTitleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

    <LineChart fx:id="priceChart" prefHeight="400" prefWidth="600" createSymbols="true">
        <xAxis>
            <CategoryAxis label="Time of Bid"/>
        </xAxis>
        <yAxis>
            <NumberAxis label="Price (VND)"/>
        </yAxis>
    </LineChart>

</VBox>